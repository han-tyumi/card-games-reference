scratch/
# Throwaway measurement scripts. They live inside the repo rather than in a
# system temp directory because node only resolves the `naibi` workspace package
# from in here, so anything that wants to import buildFigure or loadGames to
# count something has to sit alongside them.
.scratch/

# Note: rendered/ IS committed. It is generated output, but keeping it in the
# repo means the Markdown and the PDF are readable straight from GitHub without
# anyone having to install anything first. Regenerate it rather than editing it:
#   npm run render && npm run pdf

# Source text pulled down for an originality check. Someone else's copyrighted
# prose, kept locally for the length of a check and deleted afterwards. Never
# commit it -- that would be the exact thing the check exists to prevent.
.sources/

# Subagent-driven-development scratch: ledgers, briefs and review packages.
.superpowers/
