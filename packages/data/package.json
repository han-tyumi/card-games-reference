{
  "name": "naibi",
  "version": "0.5.0",
  "type": "module",
  "description": "Original, openly-licensed rules for traditional and popular card games, as structured data",
  "license": "(MIT AND CC-BY-SA-4.0)",
  "homepage": "https://han-tyumi.github.io/naibi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/han-tyumi/naibi.git",
    "directory": "packages/data"
  },
  "bugs": {
    "url": "https://github.com/han-tyumi/naibi/issues"
  },
  "keywords": [
    "card-games",
    "rules",
    "reference",
    "open-data"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/game.schema.json",
    "./games/*": "./games/*.json"
  },
  "files": [
    "games",
    "schema",
    "src",
    "LICENSE",
    "LICENSE-CODE"
  ],
  "scripts": {
    "types": "json2ts --input schema/game.schema.json --output schema/game.types.ts --maxItems -1"
  }
}
